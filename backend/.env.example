# =====================================================
# G3 Backend · variables de entorno
# =====================================================

NODE_ENV=development
PORT=8080
API_BASE_URL=http://localhost:8080

# ---------- Postgres (Cloud SQL en producción) ----------
DATABASE_URL=postgres://g3_user:g3_pass@localhost:5432/g3
# En Cloud Run usar el socket Unix:
# DATABASE_URL=postgres://USER:PASS@/g3?host=/cloudsql/PROJECT:REGION:INSTANCE

# ---------- Auth (JWT) ----------
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=replace-me-too
JWT_REFRESH_EXPIRES_IN=30d

# ---------- GCP ----------
GCP_PROJECT_ID=g3-logistics-prod
GCP_REGION=us-central1
PUBSUB_TOPIC_EVENTS=g3-domain-events
PUBSUB_TOPIC_ALERTS=g3-alerts
BIGQUERY_DATASET=g3_warehouse

# ---------- Stripe (billing) ----------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Mapeo tier → price_id en Stripe
STRIPE_PRICE_STARTER=price_starter_xxx
STRIPE_PRICE_PRO=price_pro_xxx
STRIPE_PRICE_BUSINESS=price_business_xxx

# ---------- AI (provider pluggable) ----------
# valores: stub | openai | anthropic | vertex
AI_PROVIDER=stub
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-1.5-pro

# ---------- Observabilidad ----------
LOG_LEVEL=info
SENTRY_DSN=

# ---------- CORS ----------
# Lista separada por coma de orígenes permitidos
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
