# ─────────────────────────────────────────────────────────────────────────────
# G3 backend — variables de entorno (TODAS las que lee algún servicio).
#
# Copia a `.env` para docker compose (cd backend && docker compose -f
# infra/docker/docker-compose.yml --env-file .env up). NUNCA subas `.env`.
# En producción (Cloud Run) los secretos vienen de Secret Manager con
# `--set-secrets`; aquí solo hay valores de DESARROLLO.
#
# Columna "Servicios": quién la lee. (prod: obligatoria) = el servicio no
# arranca en NODE_ENV=production sin ella.
# Generar valores aleatorios:
#   openssl rand -base64 32         # llaves de 32 bytes (AES-256)
#   openssl rand -hex 32            # tokens/secretos de 64 caracteres
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
# development | production. En production los secretos son obligatorios.
NODE_ENV=development
# Puerto HTTP. Cada servicio tiene su default (gateway 8080, auth 8081,
# billing 8082, drivers 8083, fleet 8084, trips 8085, alerts 8086, ai 8087,
# integrations 8088). En Cloud Run siempre 8080.
# PORT=

# ── JWT (auth emite, gateway valida) ─────────────────────────────────────────
# Firma de access tokens. auth + gateway (mismo valor). ≥ 32 caracteres. (prod: obligatoria)
JWT_ACCESS_SECRET=dev-access-secret-min-32-chars-aaaaaaaaa
# Firma de refresh tokens. auth. ≥ 32 caracteres. (prod: obligatoria)
JWT_REFRESH_SECRET=dev-refresh-secret-min-32-chars-bbbbbbbbb
# Vigencias en segundos. auth.
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800
# Costo de bcrypt. auth.
BCRYPT_ROUNDS=12

# ── MFA (auth) ───────────────────────────────────────────────────────────────
# Firma del mfaToken del paso 2 (distinto de JWT_ACCESS_SECRET). (prod: obligatoria)
MFA_TOKEN_SECRET=dev-mfa-token-secret-min-32-chars-mmmmmm
# Llave AES-256-GCM (32 bytes en base64) para cifrar secretos TOTP. Vacía en
# dev = llave derivada de prueba. (prod: obligatoria)
MFA_ENCRYPTION_KEY=
# Pepper HMAC de códigos de recuperación (y del OTP/reset si no hay otro). (prod: obligatoria)
MFA_RECOVERY_PEPPER=dev-recovery-pepper-min-32-chars-pppppppp
# Emisor que muestra la app autenticadora.
MFA_ISSUER=G3 Admin

# ── SSO OIDC y recuperación de contraseña (auth) ─────────────────────────────
# Callback registrado en Google/Entra.
SSO_REDIRECT_URI=http://localhost:3001/login/sso/callback
# Página de Admin para restablecer contraseña (se le agrega ?token=).
PASSWORD_RESET_URL=https://admin.g3logistics.mx/login/reset
# El client_secret de cada IdP se guarda como referencia en la config SSO:
# `projects/<p>/secrets/<s>[/versions/<v>]` (Secret Manager) o `env:NOMBRE`.

# ── Comunicación servicio → servicio ─────────────────────────────────────────
# Token compartido (`x-internal-token`). MISMO valor en auth, billing, fleet,
# trips, alerts e integrations. ≥ 32 caracteres. El gateway nunca lo reenvía.
# (prod: obligatoria en integrations)
INTERNAL_TOKEN=dev-internal-token-min-32-chars-cccccccc
# Token de ingesta de la bitácora de auth (POST /api/audit/events). Si falta,
# auth/trips/integrations usan INTERNAL_TOKEN. auth exige ≥ 32 caracteres.
AUDIT_INGEST_TOKEN=dev-internal-token-min-32-chars-cccccccc

# URLs internas (sin /api). gateway las usa para rutear; además:
#  AUTH_URL         → trips e integrations (auditoría)
#  ALERTS_URL       → fleet (señales de telemetría al centro de incidentes)
#  TRIPS_URL        → fleet (viaje activo por vehículo)
#  INTEGRATIONS_URL → auth, alerts, billing (configuración de proveedores)
AUTH_URL=http://localhost:8081
BILLING_URL=http://localhost:8082
DRIVERS_URL=http://localhost:8083
FLEET_URL=http://localhost:8084
TRIPS_URL=http://localhost:8085
ALERTS_URL=http://localhost:8086
AI_URL=http://localhost:8087
INTEGRATIONS_URL=http://localhost:8088

# ── Gateway ──────────────────────────────────────────────────────────────────
# Saltos de proxy confiables delante del gateway (LB de GCP = 2).
TRUST_PROXY_HOPS=1
# Rate limit de rutas públicas sensibles (todas opcionales; 0/false apaga).
RATE_LIMIT_ENABLED=1
# Login/OTP/reset por IP: intentos y ventana (default 30 / 60 000 ms).
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_AUTH_WINDOW_MS=60000
# Por cuenta (correo/teléfono): default 10 / 900 000 ms.
RATE_LIMIT_AUTH_ID_MAX=10
RATE_LIMIT_AUTH_ID_WINDOW_MS=900000
# Webhooks de telemetría por IP: default 3000 / 60 000 ms.
RATE_LIMIT_INGEST_MAX=3000
RATE_LIMIT_INGEST_WINDOW_MS=60000

# ── Módulo de integraciones (services/integrations) ──────────────────────────
# Id de la compañía de G3 Tech: solo sus owner/admin editan el alcance
# plataforma (Stripe, Vertex, Storage, defaults de SMS/correo/WhatsApp/PAC).
# Vacío = nadie puede editar plataforma.
G3_PLATFORM_COMPANY_ID=
# Llave AES-256-GCM (32 bytes en base64) para los secretos capturados en
# Admin. Vacía en dev = llave derivada de prueba. (prod: obligatoria)
# Rotarla deja ilegibles los secretos cifrados: vuelve a capturarlos.
INTEGRATIONS_ENCRYPTION_KEY=

# ── Respaldo de proveedores por entorno (si no hay config en Admin) ──────────
# Orden de resolución: compañía → plataforma → estas variables → modo registro.
# Push (alerts): 1 = envía por Expo.
EXPO_PUSH_ENABLED=
# Solo si activaste "enhanced push security" en Expo.
EXPO_ACCESS_TOKEN=
# WhatsApp Cloud API (alerts).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE=g3_incidente
WHATSAPP_LANGUAGE=es_MX
# Stripe (billing). Con llave y sin adaptador real de Checkout, billing responde 501.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Vertex AI (ai).
VERTEX_LOCATION=us-central1
VERTEX_MODEL=
# Evidencias (trips).
EVIDENCE_BUCKET=
EVIDENCE_SIGNER_SA=
# SMS, correo y PAC NO tienen respaldo por entorno: se configuran en Admin.

# ── Google Cloud ─────────────────────────────────────────────────────────────
# Proyecto GCP. Con valor, auth publica eventos en Pub/Sub; también es el
# respaldo de Vertex AI (categoría ai).
GCP_PROJECT_ID=
# Tópico de eventos de dominio.
PUBSUB_TOPIC=g3-domain-events
# Emulador local de Pub/Sub (docker compose).
PUBSUB_EMULATOR_HOST=localhost:8085
# Secret Manager: los secretos `gsm:projects/<p>/secrets/<s>/versions/<v>` se
# leen con la cuenta de servicio del runtime (metadata server de Cloud Run);
# necesita roles/secretmanager.secretAccessor. Fuera de GCP usa `env:` o literales.

# ── Persistencia y operación (@g3/platform) ──────────────────────────────────
# Ambiente lógico: prefijo de llaves en Redis (g3:<G3_ENV>:<svc>:…). dev | staging | production.
G3_ENV=dev
# Postgres: DATABASE_URL (runtime: rol g3_<svc>, solo DML; migraciones: g3_<svc>_migrator,
# dueño del schema; ver infra/db/init-schemas.sql) o DB_*.
# Sin ninguna, el servicio usa memoria (solo dev; en producción es obligatoria).
# En GCP: secreto g3-db-url-<svc> (IP privada de Cloud SQL, sslmode=no-verify).
# DATABASE_URL=postgres://g3_auth:g3dev@localhost:5432/g3
DB_HOST=localhost
DB_PORT=5432
DB_USER=g3
DB_PASS=g3
DB_NAME=g3
# `require` = TLS validando el certificado (DB_*). Con DATABASE_URL usar ?sslmode=.
DB_SSL=
# Conexiones por instancia. Σ(max instancias × DB_POOL_MAX) ≤ max_connections.
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
# 1 = aplica migraciones al arrancar (solo si el rol es dueño del schema). compose y GCP usan 0 y
# un contenedor/job migrate-<svc> con el rol g3_<svc>_migrator.
DB_MIGRATE_ON_BOOT=1
# Redis (Memorystore en GCP: rediss://:<auth>@<ip>:6378, secreto g3-redis-url).
# Obligatoria en producción.
REDIS_URL=redis://localhost:6379
# CA de Memorystore montada como archivo (Cloud Run: /secrets/redis-ca/ca.pem).
# NODE_EXTRA_CA_CERTS=
# gcp = las llamadas servicio→servicio llevan ID token de Cloud Run (run.invoker).
SERVICE_AUTH=
# fleet: meses de telemetría que conserva el job g3-fleet-maintenance (0 = no borra).
TELEMETRY_RETENTION_MONTHS=13
# Pruebas contra Postgres/Redis reales (CI siempre las define).
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/g3_test
# TEST_REDIS_URL=redis://localhost:6379
