{
  "//": "Typecheck de src + tests contra el código fuente de @g3/contracts (sin compilarlo). El build (tsconfig.json) resuelve @g3/contracts como paquete compilado.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@g3/contracts": [
        "../../contracts/src"
      ],
      "@g3/integrations": [
        "../../integrations-kit/src"
      ],
      "@g3/platform": [
        "../../platform-kit/src"
      ],
      "@g3/platform/testing": [
        "../../platform-kit/src/testing"
      ]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*"
  ]
}
