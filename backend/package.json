{
  "name": "g3-backend",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "contracts",
    "platform-kit",
    "integrations-kit",
    "gateway",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:contracts": "npm test --workspace contracts",
    "test:gateway": "npm test --workspace gateway",
    "test:integrations-kit": "npm test --workspace integrations-kit",
    "test:services": "for s in auth billing fleet drivers trips alerts ai invoicing integrations; do echo \"\\n=== $s ===\" && npm test --workspace services/$s || exit 1; done",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "docker compose -f infra/docker/docker-compose.yml up --build",
    "fmt": "prettier --write 'contracts/**/*.ts' 'gateway/**/*.ts' 'services/**/*.ts'",
    "test:platform-kit": "npm test --workspace platform-kit"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  }
}
