{
  "expo": {
    "name": "G3 Drive",
    "slug": "g3-logistics-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1633"
    },
    "scheme": "g3logistics",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.g3logistics.driver",
      "infoPlist": {
        "NSCameraUsageDescription": "G3 Logistics necesita la cámara para capturar evidencias de viaje.",
        "NSPhotoLibraryUsageDescription": "G3 Logistics necesita acceso a tus fotos para subir evidencias.",
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para registrar bitácoras del viaje."
      }
    },
    "android": {
      "package": "com.g3logistics.driver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1633"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-location",
      "expo-camera",
      "expo-image-picker"
    ],
    "extra": {
      "g3ApiUrl": ""
    }
  }
}
